{
  "activos": "~/desulfuracion/activos",
  "entorno": "/usr/lib/openfoam/openfoam2606/etc/bashrc",
  "variables": {"HWLOC_COMPONENTS": "-gl,-cuda,-nvml,-opencl,-rsmi,-levelzero"},
  "preparar": "preparar.sh",
  "campos_clave": ["alpha.argon", "U.argon", "U.hierro", "p", "p_rgh"],
